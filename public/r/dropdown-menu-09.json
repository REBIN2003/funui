      "content": "import { PencilLineIcon, UploadIcon, Trash2Icon } from 'lucide-react'\r\n\r\nimport { Button } from '@/components/ui/button'\r\nimport {\r\n  DropdownMenu,\r\n  DropdownMenuContent,\r\n  DropdownMenuSeparator,\r\n  DropdownMenuGroup,\r\n  DropdownMenuItem,\r\n  DropdownMenuTrigger\r\n} from '@/components/ui/dropdown-menu'\r\n\r\nconst DropdownMenuAlignStartDemo = () => {\r\n  return (\r\n    <DropdownMenu>\r\n      <DropdownMenuTrigger asChild>\r\n        <Button variant='outline'>Align Start</Button>\r\n      </DropdownMenuTrigger>\r\n      <DropdownMenuContent align='start' className='w-34'>\r\n        <DropdownMenuGroup>\r\n          <DropdownMenuItem>\r\n            <PencilLineIcon />\r\n            Edit\r\n          </DropdownMenuItem>\r\n          <DropdownMenuItem>\r\n            <UploadIcon />\r\n            Share\r\n          </DropdownMenuItem>\r\n          <DropdownMenuSeparator />\r\n          <DropdownMenuItem variant='destructive'>\r\n            <Trash2Icon />\r\n            <span>Delete</span>\r\n          </DropdownMenuItem>\r\n        </DropdownMenuGroup>\r\n      </DropdownMenuContent>\r\n    </DropdownMenu>\r\n  )\r\n}\r\n\r\nexport default DropdownMenuAlignStartDemo\r\n",
