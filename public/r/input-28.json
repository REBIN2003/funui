{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "input-28",
  "title": "Input 28",
  "description": "A URL input field with a protocol selector dropdown at the start",
  "registryDependencies": [
    "input",
    "label",
    "select"
  ],
  "files": [
