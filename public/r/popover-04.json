{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "popover-04",
  "title": "Popover 4",
  "description": "A volume control popover with a slider for adjusting audio levels",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "button",
    "label",
    "popover",
    "slider"
  ],
  "files": [
    {
      "path": "src/components/shadcn-studio/popover/popover-04.tsx",
      "content": "'use client'\r\n\r\nimport { useState } from 'react'\r\n\r\nimport { Volume2Icon, VolumeXIcon } from 'lucide-react'\r\n\r\nimport { Button } from '@/components/ui/button'\r\nimport { Label } from '@/components/ui/label'\r\nimport { Popover, PopoverContent, PopoverTrigger } from '@/components/ui/popover'\r\nimport { Slider } from '@/components/ui/slider'\r\n\r\nconst PopoverVolumeDemo = () => {\r\n  const [value, setValue] = useState([45])\r\n\r\n  return (\r\n    <Popover>\r\n      <PopoverTrigger asChild>\r\n        <Button variant='outline' size='icon'>\r\n          <Volume2Icon />\r\n          <span className='sr-only'>Volume control</span>\r\n        </Button>\r\n      </PopoverTrigger>\r\n      <PopoverContent className='w-80'>\r\n        <div className='space-y-3'>\r\n          <div className='flex items-center justify-between gap-2'>\r\n            <Label className='leading-5'>Volume</Label>\r\n            <output className='text-sm font-medium tabular-nums'>{value[0]}</output>\r\n          </div>\r\n          <div className='flex items-center gap-2'>\r\n            <VolumeXIcon className='size-4 shrink-0 opacity-60' />\r\n            <Slider value={value} onValueChange={setValue} aria-label='Volume slider' />\r\n            <Volume2Icon className='size-4 shrink-0 opacity-60' />\r\n          </div>\r\n        </div>\r\n      </PopoverContent>\r\n    </Popover>\r\n  )\r\n}\r\n\r\nexport default PopoverVolumeDemo\r\n",
      "type": "registry:component",
      "target": "components/shadcn-studio/popover/popover-04.tsx"
    }
  ],
  "type": "registry:component"
}