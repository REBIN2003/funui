      "path": "src/components/shadcn-studio/input/input-31.tsx",
      "content": "import { useId } from 'react'\r\n\r\nimport { SendHorizonalIcon } from 'lucide-react'\r\n\r\nimport { Button } from '@/components/ui/button'\r\nimport { Input } from '@/components/ui/input'\r\nimport { Label } from '@/components/ui/label'\r\n\r\nconst InputEndInlineButtonDemo = () => {\r\n  const id = useId()\r\n\r\n  return (\r\n    <div className='w-full max-w-xs space-y-2'>\r\n      <Label htmlFor={id}>Input with end inline button</Label>\r\n      <div className='relative'>\r\n        <Input id={id} type='email' placeholder='Email address' className='pr-9' />\r\n        <Button\r\n          variant='ghost'\r\n          size='icon'\r\n          className='text-muted-foreground focus-visible:ring-ring/50 absolute inset-y-0 right-0 rounded-l-none hover:bg-transparent'\r\n        >\r\n          <SendHorizonalIcon />\r\n          <span className='sr-only'>Subscribe</span>\r\n        </Button>\r\n      </div>\r\n    </div>\r\n  )\r\n}\r\n\r\nexport default InputEndInlineButtonDemo\r\n",
      "type": "registry:component",
      "target": "components/shadcn-studio/input/input-31.tsx"
    }
  ],
  "type": "registry:component"
}