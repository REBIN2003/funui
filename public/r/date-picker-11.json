{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "date-picker-11",
  "title": "Date Picker 11",
  "description": "Date picker with time range selection (from/to times) for event scheduling",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "button",
    "calendar",
    "input",
    "label",
    "popover"
  ],
  "files": [
    {
      "path": "src/components/shadcn-studio/date-picker/date-picker-11.tsx",
      "content": "'use client'\r\n\r\nimport { useState } from 'react'\r\n\r\nimport { ChevronDownIcon } from 'lucide-react'\r\n\r\nimport { Button } from '@/components/ui/button'\r\nimport { Calendar } from '@/components/ui/calendar'\r\nimport { Input } from '@/components/ui/input'\r\nimport { Label } from '@/components/ui/label'\r\nimport { Popover, PopoverContent, PopoverTrigger } from '@/components/ui/popover'\r\n\r\nconst DatePickerAndTimeRangePicker = () => {\r\n  const [open, setOpen] = useState(false)\r\n  const [date, setDate] = useState<Date | undefined>(undefined)\r\n\r\n  return (\r\n    <div className='flex flex-col gap-6'>\r\n      <div className='flex w-full max-w-xs flex-col gap-3'>\r\n        <Label htmlFor='date' className='px-1'>\r\n          Date\r\n        </Label>\r\n        <Popover open={open} onOpenChange={setOpen}>\r\n          <PopoverTrigger asChild>\r\n            <Button variant='outline' id='date' className='w-full justify-between font-normal'>\r\n              {date ? date.toLocaleDateString() : 'Pick a date'}\r\n              <ChevronDownIcon />\r\n            </Button>\r\n          </PopoverTrigger>\r\n          <PopoverContent className='w-auto overflow-hidden p-0' align='start'>\r\n            <Calendar\r\n              mode='single'\r\n              selected={date}\r\n              onSelect={date => {\r\n                setDate(date)\r\n                setOpen(false)\r\n              }}\r\n            />\r\n          </PopoverContent>\r\n        </Popover>\r\n      </div>\r\n      <div className='flex gap-4'>\r\n        <div className='flex flex-col gap-3'>\r\n          <Label htmlFor='time-from' className='px-1'>\r\n            From\r\n          </Label>\r\n          <Input\r\n            type='time'\r\n            id='time-from'\r\n            step='1'\r\n            defaultValue='01:30:00'\r\n            className='bg-background appearance-none [&::-webkit-calendar-picker-indicator]:hidden [&::-webkit-calendar-picker-indicator]:appearance-none'\r\n          />\r\n        </div>\r\n        <div className='flex flex-col gap-3'>\r\n          <Label htmlFor='time-to' className='px-1'>\r\n            To\r\n          </Label>\r\n          <Input\r\n            type='time'\r\n            id='time-to'\r\n            step='1'\r\n            defaultValue='02:30:00'\r\n            className='bg-background appearance-none [&::-webkit-calendar-picker-indicator]:hidden [&::-webkit-calendar-picker-indicator]:appearance-none'\r\n          />\r\n        </div>\r\n      </div>\r\n    </div>\r\n  )\r\n}\r\n\r\nexport default DatePickerAndTimeRangePicker\r\n",
      "type": "registry:component",
      "target": "components/shadcn-studio/date-picker/date-picker-11.tsx"
    }
  ],
  "type": "registry:component"
}