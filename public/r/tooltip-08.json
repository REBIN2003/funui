      "content": "import { Avatar, AvatarFallback, AvatarImage } from '@/components/ui/avatar'\r\nimport { Button } from '@/components/ui/button'\r\nimport { Tooltip, TooltipContent, TooltipTrigger } from '@/components/ui/tooltip'\r\n\r\nconst TooltipAvatarDemo = () => {\r\n  return (\r\n    <Tooltip>\r\n      <TooltipTrigger asChild>\r\n        <Button variant='outline' size='sm'>\r\n          Avatar\r\n        </Button>\r\n      </TooltipTrigger>\r\n      <TooltipContent>\r\n        <div className='flex items-center gap-1.5'>\r\n          <Avatar className='size-5'>\r\n            <AvatarImage src='https://cdn.shadcnstudio.com/ss-assets/avatar/avatar-5.png' alt='Hallie Richards' />\r\n            <AvatarFallback className='text-xs'>HR</AvatarFallback>\r\n          </Avatar>\r\n          <p className='font-medium'>Hallie Richards</p>\r\n        </div>\r\n      </TooltipContent>\r\n    </Tooltip>\r\n  )\r\n}\r\n\r\nexport default TooltipAvatarDemo\r\n",
      "type": "registry:component",
      "target": "components/shadcn-studio/tooltip/tooltip-08.tsx"
    }
  ],
  "type": "registry:component"
