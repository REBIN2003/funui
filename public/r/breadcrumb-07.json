      "content": "'use client'\r\n\r\nimport { useState } from 'react'\r\n\r\nimport { ChevronsRightIcon, FolderIcon, FolderOpenIcon, HomeIcon } from 'lucide-react'\r\n\r\nimport {\r\n  Breadcrumb,\r\n  BreadcrumbItem,\r\n  BreadcrumbLink,\r\n  BreadcrumbList,\r\n  BreadcrumbPage,\r\n  BreadcrumbSeparator\r\n} from '@/components/ui/breadcrumb'\r\nimport { DropdownMenu, DropdownMenuContent, DropdownMenuItem, DropdownMenuTrigger } from '@/components/ui/dropdown-menu'\r\n\r\nconst BreadcrumbWithIconDemo = () => {\r\n  const [open, setOpen] = useState(false)\r\n\r\n  return (\r\n    <Breadcrumb>\r\n      <BreadcrumbList>\r\n        <BreadcrumbItem>\r\n          <BreadcrumbLink href='#'>\r\n            <HomeIcon className='size-4' />\r\n            <span className='sr-only'>Home</span>\r\n          </BreadcrumbLink>\r\n        </BreadcrumbItem>\r\n        <BreadcrumbSeparator>\r\n          <ChevronsRightIcon />\r\n        </BreadcrumbSeparator>\r\n        <BreadcrumbItem className='flex items-center gap-2'>\r\n          <DropdownMenu open={open} onOpenChange={setOpen}>\r\n            <DropdownMenuTrigger className='flex cursor-pointer items-center gap-1'>\r\n              {open ? <FolderOpenIcon className='size-4' /> : <FolderIcon className='size-4' />}\r\n              <span className='sr-only'>{open ? 'Open' : 'Close'}</span>\r\n            </DropdownMenuTrigger>\r\n            <DropdownMenuContent align='start'>\r\n              <DropdownMenuItem>Documentation</DropdownMenuItem>\r\n              <DropdownMenuItem>Themes</DropdownMenuItem>\r\n              <DropdownMenuItem>GitHub</DropdownMenuItem>\r\n            </DropdownMenuContent>\r\n          </DropdownMenu>\r\n        </BreadcrumbItem>\r\n        <BreadcrumbSeparator>\r\n          <ChevronsRightIcon />\r\n        </BreadcrumbSeparator>\r\n        <BreadcrumbItem>\r\n          <BreadcrumbPage>Add Document</BreadcrumbPage>\r\n        </BreadcrumbItem>\r\n      </BreadcrumbList>\r\n    </Breadcrumb>\r\n  )\r\n}\r\n\r\nexport default BreadcrumbWithIconDemo\r\n",
      "type": "registry:component",
      "target": "components/shadcn-studio/breadcrumb/breadcrumb-07.tsx"
    }
  ],
  "type": "registry:component"
}